<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Audit trail of every access to a real customer phone number (dial, reveal, search). Stores the masked number only. Visible to administrators through the Phone Access Audit Viewer permission set.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <label>Phone Access Audit</label>
    <nameField>
        <displayFormat>AUD-{000000}</displayFormat>
        <label>Audit Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Phone Access Audits</pluralLabel>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Action__c</fullName>
        <description>What was done with the number.</description>
        <externalId>false</externalId>
        <label>Action</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Dial</fullName>
                    <default>false</default>
                    <label>Dial</label>
                </value>
                <value>
                    <fullName>Reveal</fullName>
                    <default>false</default>
                    <label>Reveal</label>
                </value>
                <value>
                    <fullName>Search</fullName>
                    <default>false</default>
                    <label>Search</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Channel__c</fullName>
        <description>Dialer or feature that requested the number, e.g. MCube, SlashRTC.</description>
        <externalId>false</externalId>
        <label>Channel</label>
        <length>80</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Comment__c</fullName>
        <description>Comment given with a reveal (required when the reason is Other).</description>
        <externalId>false</externalId>
        <label>Comment</label>
        <length>1000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Event_Time__c</fullName>
        <defaultValue>NOW()</defaultValue>
        <description>When the request was made.</description>
        <externalId>false</externalId>
        <label>Event Time</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Field_Key__c</fullName>
        <description>Object.Field of the number requested, e.g. Lead.Phone__c.</description>
        <externalId>false</externalId>
        <label>Field Key</label>
        <length>120</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Masked_Number__c</fullName>
        <description>Masked form of the number (never the real number).</description>
        <externalId>false</externalId>
        <label>Masked Number</label>
        <length>40</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Message__c</fullName>
        <description>Why a request was denied or failed.</description>
        <externalId>false</externalId>
        <label>Message</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Object_Name__c</fullName>
        <description>API name of the object of the record.</description>
        <externalId>false</externalId>
        <label>Object Name</label>
        <length>80</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Outcome__c</fullName>
        <description>Result of the request.</description>
        <externalId>false</externalId>
        <label>Outcome</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Success</fullName>
                    <default>false</default>
                    <label>Success</label>
                </value>
                <value>
                    <fullName>Denied</fullName>
                    <default>false</default>
                    <label>Denied</label>
                </value>
                <value>
                    <fullName>Not Found</fullName>
                    <default>false</default>
                    <label>Not Found</label>
                </value>
                <value>
                    <fullName>Error</fullName>
                    <default>false</default>
                    <label>Error</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Reason__c</fullName>
        <description>Reason given for a reveal.</description>
        <externalId>false</externalId>
        <label>Reason</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Record_Id__c</fullName>
        <description>Id of the record whose number was requested.</description>
        <externalId>false</externalId>
        <label>Record Id</label>
        <length>18</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>User__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>User who requested the number.</description>
        <externalId>false</externalId>
        <label>User</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Phone_Access_Audits</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Event_Time__c</columns>
        <columns>Action__c</columns>
        <columns>Outcome__c</columns>
        <columns>User__c</columns>
        <columns>Object_Name__c</columns>
        <columns>Record_Id__c</columns>
        <columns>Field_Key__c</columns>
        <columns>Masked_Number__c</columns>
        <columns>Channel__c</columns>
        <columns>Reason__c</columns>
        <columns>Comment__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
</CustomObject>
