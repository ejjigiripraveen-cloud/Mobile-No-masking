<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Approved list of phone fields that may be dialed or revealed through MaskedDialService. Any field not listed and active is refused.</description>
    <label>Masked Phone Field</label>
    <pluralLabel>Masked Phone Fields</pluralLabel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Only active records are used.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Allow_Dial__c</fullName>
        <defaultValue>false</defaultValue>
        <description>The number may be resolved for click-to-dial.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Allow Dial</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Allow_Reveal__c</fullName>
        <defaultValue>false</defaultValue>
        <description>The number may be revealed to users with the Reveal permission.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Allow Reveal</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Display_Label__c</fullName>
        <description>Label shown next to the masked number, e.g. Primary.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Display Label</label>
        <length>40</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Field_API_Name__c</fullName>
        <description>API name of the phone field, e.g. Phone__c.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Field API Name</label>
        <length>80</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Object_API_Name__c</fullName>
        <description>API name of the object, e.g. Lead.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Object API Name</label>
        <length>80</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sort_Order__c</fullName>
        <description>Display order in the masked phone panel.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Sort Order</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
</CustomObject>
