<!--
================================================================================
 mcubeSoftphoneCTI.page
================================================================================
 
 @description  Visualforce page that serves as the Salesforce Open CTI adapter
               for the MCube Softphone integration. This page:
 
               1. Embeds the MCube web-based softphone widget via an iframe
               2. Loads the Salesforce Open CTI JavaScript library
               3. Listens for the MCube 'OpenPanel' postMessage envelope and
                  screen-pops the related record's detail page
               4. Supports outbound click-to-dial via the MCube outbound API
                  (Open CTI Click-to-Dial here calls
                  MCubeSoftphoneController.clickToCallRemote; the mcubeClick2Call
                  Aura quick action calls clickToCall directly)
 
 @controller   MCubeSoftphoneController — provides the authenticated iframe
               URL, call routing and click-to-dial methods.
 
 @usage        This page URL is set as the "CTI Adapter URL" in the
               Call Center Definition XML. Salesforce loads it inside the
               softphone utility bar panel.
 
 @see          MCubeSoftphoneController.cls
 @see          Salesforce Open CTI Developer Guide
 @author       MCube Integration Team
 @version      1.0
 @since        2026-03-27
 
 SECURITY NOTE:
   - All postMessage events are validated against the MCube origin
     (https://mcube.vmc.in) to prevent cross-origin injection attacks.
   - Credentials are managed server-side in the Apex controller.
   - Never expose auth tokens in client-side JavaScript.
 
 EVENT CONTRACT (MCube → Salesforce):
   The MCube widget posts a single structured envelope on a ringing /
   initiated call (both outbound and inbound):
   {
     Type:   String  — 'MCUBE'
     Action: String  — 'OpenPanel'
     Data:   Object  — {
                          "Customer Number": String — customer phone number
                          callid           : String — MCube call identifier
                          didId            : String — DID / landing number
                          refid            : String — Salesforce record id (may be '')
                          type             : String — 'outbound_call' | 'inbound_call'
                        }
   }
   On OpenPanel we show the softphone panel and open the related record's
   detail page in the active tab — using refid when present, otherwise
   resolving it via the call-routing service (mcubeCallRouting.route) by
   passing the customer number + DID (didId / landing number).
 
 EVENT CONTRACT (Salesforce → MCube):
   Click-to-dial / control commands sent to the MCube widget. The widget's
   inbound message handler expects MCube's own structured envelope (the same
   { Type, Action, Data } shape the widget emits back to Salesforce) — NOT a
   flat { type: 'DIAL' } object:
   {
     Type:   String  — 'MCUBE'
     Action: String  — 'DIAL' | 'HANGUP' | 'HOLD' | 'MUTE'
     Data:   Object  — { number: '<phone>' } for DIAL
   }
================================================================================
-->
<apex:page controller="McubeSoftphoneAddOnController"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           applyHtmlTag="true"
           applyBodyTag="false"
           docType="html-5.0">
 
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MCube Softphone</title>
 
    <!-- ===================================================================
         STYLES — Softphone Panel Layout
         Minimal styling to ensure the MCube iframe fills the softphone
         panel completely. The panel dimensions are controlled by the
         Call Center Definition (400h × 300w).
    ==================================================================== -->
    <style>
        /* Reset — remove default browser margins/padding */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
 
        /* Full-height body to fill the softphone panel */
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Salesforce Sans', Arial, sans-serif;
            background-color: #f4f6f9;
        }
 
        /* Container for the softphone iframe */
        .softphone-container {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
        }
 
        /* MCube iframe — fills entire container */
        .mcube-iframe {
            width: 100%;
            flex: 1;
            border: none;
        }
 
        /* Status bar at the bottom — shows connection state */
        .status-bar {
            height: 24px;
            background-color: #16325c;
            color: #ffffff;
            font-size: 11px;
            line-height: 24px;
            text-align: center;
            flex-shrink: 0;
        }
 
        .status-bar.connected {
            background-color: #04844b;
        }
 
        .status-bar.error {
            background-color: #c23934;
        }
 
        /* Loading overlay — shown while iframe loads */
        .loading-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f4f6f9;
            z-index: 10;
        }
 
        .loading-overlay.hidden {
            display: none;
        }
 
        .spinner {
            width: 40px;
            height: 40px;
            border: 4px solid #d8dde6;
            border-top: 4px solid #0070d2;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
 
        @keyframes spin {
            0%   { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
 
<body>
 
    <!-- =================================================================
         SOFTPHONE CONTAINER
         The MCube widget is loaded inside this iframe. The src URL is
         provided by the Apex controller with authentication parameters.
    ================================================================== -->
    <div class="softphone-container">
 
        <apex:outputPanel layout="none" rendered="{!mcubeIframeUrl != ''}">
            <!-- Loading spinner — hidden once iframe loads -->
            <div id="loadingOverlay" class="loading-overlay">
                <div class="spinner"></div>
            </div>
 
            <!-- MCube Softphone Widget iframe -->
            <iframe id="mcubeFrame"
                    class="mcube-iframe"
                    src="{!mcubeIframeUrl}"
                    allow="microphone; autoplay"
                    sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
                    title="MCube Softphone Widget">
            </iframe>
 
            <!-- Connection status bar -->
            <div id="statusBar" class="status-bar">
                Initializing CTI Adapter...
            </div>
        </apex:outputPanel>
 
        <apex:outputPanel layout="none" rendered="{!mcubeIframeUrl == ''}">
            <div style="display:flex; align-items:center; justify-content:center; height:100%; color:#54698d; font-size:13px; text-align:center; padding:20px;">
                CTI is not enabled for your user account.<br/>
                Please contact your administrator.
            </div>
        </apex:outputPanel>
 
    </div>
 
    <!-- =================================================================
         SALESFORCE OPEN CTI LIBRARY
         This is the official Salesforce Open CTI JavaScript API.
         It MUST be loaded from the Salesforce instance (not a CDN).
         The API version should match your org's API version.
    ================================================================== -->
    <script src="/support/api/60.0/lightning/opencti_min.js"></script>
 
    <!-- =================================================================
         MCube CTI ADAPTER — Core Integration Logic
    ================================================================== -->
    <script>
    (function() {
        'use strict';
 
        // Skip CTI initialization if the user is not a CTI user
        var isCTIEnabled = '{!JSENCODE(mcubeIframeUrl)}' !== '';
        if (!isCTIEnabled) {
            console.log('[MCube CTI] CTI is not enabled for this user — skipping initialization');
            return;
        }
 
        // =================================================================
        // CONFIGURATION
        // =================================================================
 
        /**
         * Trusted origin for the MCube iframe.
         * SECURITY: Only accept postMessage events from this origin.
         * Value is set by the Apex controller to keep it server-managed.
         */
        var MCUBE_ORIGIN = '{!JSENCODE(mcubeOrigin)}';
 
        // =================================================================
        // STATE MANAGEMENT
        // =================================================================
 
        /**
         * Tracks the current call context for screen-pop and outbound dialing.
         */
        var currentCall = {
            callId         : null,
            direction      : null,   // 'inbound' or 'outbound'
            phoneNumber    : null,
            recordId       : null,   // Salesforce record ID (from screen pop)
            objectType     : null,   // SObject type
            startTime      : null,
            customerNumber : null,
            landingNumber  : null
        };
 
        // =================================================================
        // DOM REFERENCES
        // =================================================================
 
        var mcubeFrame     = document.getElementById('mcubeFrame');
        var statusBar      = document.getElementById('statusBar');
        var loadingOverlay = document.getElementById('loadingOverlay');
 
        // =================================================================
        // UTILITY FUNCTIONS
        // =================================================================
 
        /**
         * Updates the status bar text and color.
         * @param {String} message — Status text to display
         * @param {String} state  — 'default' | 'connected' | 'error'
         */
        function updateStatus(message, state) {
            statusBar.textContent = message;
            statusBar.className = 'status-bar';
            if (state === 'connected') {
                statusBar.classList.add('connected');
            } else if (state === 'error') {
                statusBar.classList.add('error');
            }
        }
 
        /**
         * Safely logs messages with a consistent prefix for debugging.
         * @param {String} message — Log message
         * @param {*}      data    — Optional data to log
         */
        function log(message, data) {
            if (data !== undefined) {
                console.log('[MCube CTI] ' + message, data);
            } else {
                console.log('[MCube CTI] ' + message);
            }
        }
 
        // =================================================================
        // OPEN CTI INITIALIZATION
        // =================================================================
 
        /**
         * Mobile number masking (v1.3.0). Returns { fieldKey, maskedNumber } when the click came from
         * the masked phone panel (params contain fieldKey=..., or the number is masked with X),
         * otherwise null. Real phone numbers never contain X.
         *
         * @param {Object} result — the onClickToDial payload.
         */
        function getMaskedClick(result) {
            var fieldKey = '';
            var params = result && result.params;
            if (params && typeof params === 'object' && params.fieldKey) {
                fieldKey = String(params.fieldKey);
            } else if (typeof params === 'string') {
                params.split(',').forEach(function(pair) {
                    var parts = pair.split('=');
                    if (parts.length === 2 && parts[0].trim() === 'fieldKey') {
                        fieldKey = parts[1].trim();
                    }
                });
            }
            var number = (result && result.number) ? String(result.number) : '';
            if (!fieldKey && !/[xX]/.test(number)) {
                return null;
            }
            return { fieldKey: fieldKey, maskedNumber: number };
        }

        /**
         * Enable Click-to-Dial across all Salesforce pages.
         * When enabled, phone number fields become clickable links that
         * trigger our onClickToDial listener.
         */
        sforce.opencti.enableClickToDial({
            callback: function(response) {
                if (response.success) {
                    log('Click-to-Dial enabled successfully');
                } else {
                    log('Failed to enable Click-to-Dial:', response.errors);
                }
            }
        });
 
        /**
         * Register the Click-to-Dial listener.
         * Fires when an agent clicks any phone number link in Salesforce.
         * We forward the number to the MCube iframe to initiate the call.
         *
         * The response object contains:
         *   - number:      The phone number clicked
         *   - recordId:    The Salesforce record ID
         *   - objectType:  The SObject type (Contact, Lead, Account, etc.)
         */
        sforce.opencti.onClickToDial({
            listener: function(result) {
                log('Click-to-Dial triggered:', result);
 
                // Update current call state
                currentCall.phoneNumber = result.number;
                currentCall.recordId    = result.recordId;
                currentCall.objectType  = result.objectType;
                currentCall.direction   = 'outbound';
 
                // Mobile number masking (v1.3.0): a click on the masked phone panel carries a masked
                // value (e.g. 98XXXXXX21) and a field key. The real number is resolved on the server
                // by clickToCallMasked and is never sent to this page. Every other click is unchanged.
                var maskedClick = getMaskedClick(result);
                var remoteAction = maskedClick
                    ? '{!$RemoteAction.McubeSoftphoneAddOnController.clickToCallMasked}'
                    : '{!$RemoteAction.McubeSoftphoneAddOnController.clickToCallRemote}';
                var onCallResult = function(res, event) {
                    if (event.status && res && res.success) {
                        log('Click-to-Dial outbound call placed: ' + result.number);
                    } else {
                        var msg = (res && res.message) ? res.message
                            : (event && event.message ? event.message : 'call failed');
                        log('Click-to-Dial outbound call failed: ' + msg);
                        updateStatus('Call failed: ' + msg, 'error');
                    }
                };

                // Place the outbound call through the MCube outbound API
                // (the same path as the mcubeClick2Call Aura quick action)
                // instead of sending a DIAL envelope to the widget.
                updateStatus('Dialing: ' + result.number, 'default');
                if (maskedClick) {
                    Visualforce.remoting.Manager.invokeAction(
                        remoteAction,
                        result.recordId || '',
                        maskedClick.fieldKey,
                        maskedClick.maskedNumber,
                        onCallResult,
                        { escape: false }
                    );
                } else {
                    Visualforce.remoting.Manager.invokeAction(
                        remoteAction,
                        result.recordId || '',
                        result.number,
                        onCallResult,
                        { escape: false }
                    );
                }
 
                // Ensure the softphone panel is visible
                sforce.opencti.setSoftphonePanelVisibility({
                    visible: true,
                    callback: function(response) {
                        if (response.success) {
                            log('Softphone panel shown for outbound call');
                        }
                    }
                });
            }
        });
 
        /**
         * Register navigation change listener.
         * Fires when the agent navigates to a different Salesforce page.
         * Useful for maintaining context awareness.
         */
        sforce.opencti.onNavigationChange({
            listener: function(result) {
                log('Navigation changed:', result);
            }
        });
 
        // =================================================================
        // MCUBE EVENT HANDLERS
        //
        // The MCube widget drives this adapter with a single inbound event:
        //   { Type:'MCUBE', Action:'OpenPanel', Data:{ ... } }
        // fired on both outbound and inbound calls. We open the softphone
        // panel and screen-pop the related record's detail page (resolving it
        // via the call-routing service when no record id is echoed back).
        // =================================================================
 
        /**
         * Opens a record's detail page in the agent's active tab.
         *
         * Uses Open CTI screenPop with an SObject target, which navigates the
         * currently focused console tab to the record's detail page (or opens
         * it when none is focused).
         *
         * @param {String} recordId — The Salesforce record ID to open.
         */
        function openRecordInActiveTab(recordId) {
            if (!recordId) {
                log('openRecordInActiveTab called without a recordId — skipping');
                return;
            }
 
            currentCall.recordId = recordId;
 
            sforce.opencti.screenPop({
                type   : sforce.opencti.SCREENPOP_TYPE.SOBJECT,
                params : { recordId: recordId },
                callback: function(response) {
                    if (response.success) {
                        log('Opened record detail page in active tab: ' + recordId);
                    } else {
                        log('Failed to open record detail page:', response.errors);
                    }
                }
            });
        }
 
        /**
         * MCUBE "OpenPanel" ENVELOPE HANDLER
         * Triggered when the MCube widget posts its structured envelope
         *   { Type:'MCUBE', Action:'OpenPanel', Data:{ ... } }
         * on a ringing/initiated call.
         *
         * The Data payload looks like:
         *   {
         *     "Customer Number": "7989097566",  — customer's phone number
         *     callid           : "9025...",     — MCube call identifier
         *     didId            : "00918064...", — DID / landing number
         *     refid            : "",            — Salesforce record id (if known)
         *     target           : { ... },
         *     timeStamp        : 1782228053348,
         *     type             : "outbound_call" | "inbound_call"
         *   }
         *
         * Behaviour:
         *   1. Make the softphone panel visible.
         *   2. If MCube already echoed a record id (refid), open that record's
         *      detail page in the active tab directly.
         *   3. Otherwise resolve the record through the call-routing service
         *      (mcubeCallRouting.route, passing the DID + customer number) and
         *      open the returned record's detail page in the active tab.
         *
         * @param {Object} envelope — The full { Type, Action, Data } envelope.
         */
        function handleMcubeOpenPanel(envelope) {
            var payload = envelope.Data || {};
 
            // MCube uses a space in the customer-number key; tolerate variants.
            var customerNumber = payload['Customer Number']
                              || payload.customerNumber
                              || payload.CustomerNumber
                              || '';
            var landingNumber  = payload.didId || payload.did || '';
            var recordId       = payload.refid || '';
            var callType       = payload.type || '';
 
            log('MCube OpenPanel — customer: ' + customerNumber
                + ', did: ' + landingNumber
                + ', refid: ' + (recordId || '(none)')
                + ', type: ' + callType);
 
            // Track call context for screen-pop / outbound dialing
            currentCall.callId         = payload.callid || currentCall.callId;
            currentCall.phoneNumber    = customerNumber;
            currentCall.customerNumber = customerNumber;
            currentCall.landingNumber  = landingNumber;
            currentCall.direction      =
                (callType.indexOf('inbound') !== -1) ? 'inbound' : 'outbound';
 
            // 1. Always surface the softphone panel
            sforce.opencti.setSoftphonePanelVisibility({
                visible  : true,
                callback : function(response) {
                    if (response.success) {
                        log('Softphone panel shown (MCube OpenPanel)');
                    }
                }
            });
 
            updateStatus('Call: ' + customerNumber, 'default');
 
            // 2. Record id already known → open it directly
            if (recordId) {
                log('refid present — opening record directly: ' + recordId);
                openRecordInActiveTab(recordId);
                return;
            }
 
            // 3. No record id → resolve it via the call-routing service.
            //    Routing only needs the customer number: the DID selects the
            //    MCUBE Object Api records to search, and when it is blank (or maps
            //    to nothing) routing falls back to the default records instead.
            //    Some OpenPanel events — notably the initial incoming-call ring —
            //    arrive with no call data at all (Customer Number / didId / refid
            //    are undefined). Without a customer number there is nothing to
            //    route on, so just leave the panel open.
            if (!customerNumber) {
                log('OpenPanel has no customer number (likely an incoming ring) — '
                    + 'panel shown, skipping routing.');
                return;
            }
 
            log('No refid — routing via mcubeCallRouting.route (customer number + did)');
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.McubeSoftphoneAddOnController.mcubeCallRouting}',
                customerNumber,
                landingNumber,
                function(result, event) {
                    if (event.status && result) {
                        try {
                            var parsed = JSON.parse(result);
                            log('Call routing result:', parsed);
 
                            if (parsed.relatedToId) {
                                openRecordInActiveTab(parsed.relatedToId);
                            } else {
                                log('Call routing returned no record (status: '
                                    + parsed.status + '): ' + parsed.message);
                            }
                        } catch (parseErr) {
                            log('Failed to parse call routing result:', parseErr);
                        }
                    } else {
                        log('Call routing remoting failed:', event ? event.message : null);
                    }
                },
                { escape: false }
            );
        }
 
        // =================================================================
        // POSTMESSAGE EVENT LISTENER (MCube → Salesforce)
        // =================================================================
 
        /**
         * Central event listener for MCube iframe postMessage events.
         *
         * SECURITY: Every message is validated against MCUBE_ORIGIN before
         * processing. Messages from any other origin are silently ignored.
         *
         * The MCube widget drives this adapter with a single envelope:
         *   { Type:'MCUBE', Action:'OpenPanel', Data:{ ... } }
         * fired on both outbound and inbound calls. Everything else is
         * ignored.
         */
        window.addEventListener('message', function(event) {
 
            // ---------------------------------------------------------
            // DIAGNOSTIC: log every inbound postMessage and its origin so
            // we can confirm messages reach this page and see the actual
            // origin they arrive from. Remove once the origin is confirmed.
            // ---------------------------------------------------------
 
            log('postMessage received — origin="' + event.origin
                + '" | trusted="' + MCUBE_ORIGIN + '"', event.data);
 
            // ---------------------------------------------------------
            // SECURITY CHECK: Validate the message origin.
            // Only accept messages from the trusted MCube domain to prevent
            // cross-origin attacks where a malicious page could send fake
            // call events to trigger screen pops.
            // ---------------------------------------------------------
            if (event.origin !== MCUBE_ORIGIN) {
                log('REJECTED message — origin "' + event.origin
                    + '" does not match trusted "' + MCUBE_ORIGIN + '"');
                return;
            }
 
            var data = event.data;
 
            // ---------------------------------------------------------
            // MCUBE OpenPanel ENVELOPE
            //   { Type:'MCUBE', Action:'OpenPanel', Data:{ ... } }
            // Open the softphone panel and screen-pop the related record's
            // detail page (resolving it via the call-routing service when no
            // record id / refid is echoed back).
            // ---------------------------------------------------------
            if (data && data.Type === 'MCUBE') {
                log('MCube envelope received. Action: ' + data.Action, data);
 
                if (data.Action === 'OpenPanel') {
                    handleMcubeOpenPanel(data);
                }
                return;
            }
 
            // Anything else is not part of the MCube OpenPanel contract.
            // log('Ignored non-MCUBE message', data);
 
        }, false);
 
        // =================================================================
        // IFRAME LOAD HANDLER
        // =================================================================
 
        /**
         * Detect when the MCube iframe has finished loading.
         * Hides the loading overlay and updates the status.
         *
         * Note: The iframe 'load' event fires when the page loads, but the
         * MCube widget may still need time to initialize, so we hide the
         * overlay after a short delay.
         */
        mcubeFrame.addEventListener('load', function() {
            log('MCube iframe loaded');
            // Hide the loading overlay shortly after the iframe loads
            setTimeout(function() {
                if (!loadingOverlay.classList.contains('hidden')) {
                    loadingOverlay.classList.add('hidden');
                    updateStatus('Ready', 'connected');
                }
            }, 5000);
        });
 
        // =================================================================
        // CTI ADAPTER READY — Final initialization log
        // =================================================================
 
        log('MCube CTI Adapter initialized');
        log('Trusted origin: ' + MCUBE_ORIGIN);
        log('Open CTI API version: 60.0');
 
        // Click-to-Call is placed through the MCube outbound API (Apex
        // MCubeSoftphoneController.clickToCall / clickToCallRemote). The
        // mcubeClick2Call Aura quick action calls the Apex directly and the
        // Open CTI onClickToDial handler above calls clickToCallRemote — so
        // the page no longer subscribes to the Dial_Command__c channel or
        // sends DIAL envelopes to the widget.
 
    })();
    </script>
 
</body>
</html>
 
</apex:page>