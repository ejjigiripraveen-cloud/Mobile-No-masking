        <rules>
            <name>Zone_is_Coimbatore_Trichy_Madurai_Hosur</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Site_visit_Record.Zone__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Coimbatore</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Site_visit_Record.Zone__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hosur</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Site_visit_Record.Zone__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Madurai</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Site_visit_Record.Zone__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Trichy</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Zone_to_a_variable</targetReference>
            </connector>
            <label>Zone is Coimbatore, Trichy, Madurai, Hosur</label>
        </rules>
        <rules>
            <name>Zone_is_Chennai_Mysore_Bangalore_Hyderabad_Tirupati</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Site_visit_Record.Zone__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Tirupati</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Site_visit_Record.Zone__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hyderabad</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Site_visit_Record.Zone__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Bangalore</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Site_visit_Record.Zone__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Mysore</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Site_visit_Record.Zone__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Chennai</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Assign_Zone_to_a_Variable</targetReference>
            </connector>
            <label>Zone is Chennai, Mysore, Bangalore, Hyderabad, Tirupati</label>
        </rules>
