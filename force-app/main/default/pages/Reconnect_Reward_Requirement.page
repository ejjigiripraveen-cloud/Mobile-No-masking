<apex:page renderAs="pdf" applyBodyTag="false" standardController="opportunity"  applyHtmlTag="false" showHeader="false" >
    <head>
        <style>
            @page {
            size:legal;
            margin:0px;
            @font-face { font-family: Times, serif;
            }
            @top-center {
            content: element(header);
            }
            @bottom-left {
            content: element(footer);
            }
            }
            div.header {
            position: running(header);
            }
            div.footer {
            display: block;
            position: running(footer);
            }
            .pagenumber:before {
            content: counter(page);
            }
            .pagecount:before {
            content: counter(pages);
            }
            
            
            .pushTop{
            text-align:center;
            vertical-align:top;
            }
            .pushTop11{
            vertical-align:center;
            text-align:center;
            }
            .pushTop1{
            vertical-align:top;
            }
            
            
            
            body{font-size:14.5px;
            font-family:Time Nuremon;
            word-spacing: 3px;
            line-height:1.65;
            text-align:justify;
            }
            .border   { 
            border:0.5px solid black;
            border-collapse:collapse;
            //border-width: thin;//
            }
              td.label {
            padding-right: 2px;
           
            vertical-align: top;
            }
            
             td.underline {
            border-bottom: 0.8px solid #000;
            
            vertical-align: bottom;
            
            }
            span.underline {
            border-bottom: 0.5px solid #000;
            //min-width: 100px;//
            padding-bottom: 2px;
            vertical-align: bottom;
            }
            div.underline {
            border-bottom: 1px solid #D5B793;
            //width: 250px;//
            padding-bottom: 1px;
            align: center;
            }
            
            
            
            
            
            
        </style>
    </head>
