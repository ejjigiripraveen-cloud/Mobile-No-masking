<apex:page showHeader="false" sidebar="false" standardController="Opportunity"  renderAs="pdf" extensions="ControllerClassHandler"> 
    <head>
        <style>
            table {
                border-collapse:collapse;
                border-color:#4682B4;
            }
                
            td.title
            {
                border-left:1px transparent;
            <!--    border-right:none; -->
            }
            
        </style>
    </head>
   <apex:form >       
       <apex:pageBlock >
                                                <!-- Page 0 -->
        <div align = "center">
            <apex:outputPanel >
                <table width="100%" cellspacing="0">
                    <tr>
                        <td width="100%">
                        <apex:image value="{!if(contains(opportunity.Project_Name__c,'Primus'),$Resource.Primus,$Resource.OrgLogo)}" width="150" height="100"/>
                        </td>                    
                    </tr>
                    <tr> <td height = "10"> </td> </tr>
                    <tr style="text-align:center; color:#4682B4;font-size:20px;" >
                        <td height = "50"> APPLICATION FOR ALLOTMENT </td>
                    </tr>
                    <tr>
                        <td width="100%">
                        <apex:image value="{!if((Opportunity.Apartment__r.Project_Name__c = 'Mantri Serenity'),$Resource.Tempimage3,$Resource.Tempimage2)}" width="600" height="600"/>
                        </td>                    
                    </tr>
                    <tr style="text-align:center; color:#006400">
                        <td width="100%" height = "50">
                      <b>  <apex:outputField value="{!Opportunity.Apartment__r.Project_Name__c}"/> </b>
                        </td>                    
                    </tr> 
                    <tr style="text-align:center; color:#4682B4">
                        <td width="100%">
                        <apex:outputField value="{!Opportunity.Apartment__r.Block__r.Project__r.Address__c}"/>
                        </td>                    
                    </tr>
                    <tr style="text-align:center; color:#4682B4">
                       <td width="100%" height = "50">
                      <b> www.mantri.in </b>
                        </td>                    
                    </tr><br/>
                    
                    <tr style="font-size:14px; color:black; font-weight:bold"> <td> ______________________________________________&nbsp;Page 0&nbsp;_______________________________________________ </td></tr><br/> <br/>
                </table>
            </apex:outputPanel>                 
        </div> 
                                                <!-- Page 1 -->
        <table width = "100%"> 
            <tr style="font-size:14px; font-weight:bold;">
                <th colspan = "4" style="text-align:center; font-size:16px; background-color:#9E1721; color:White"> PERSONAL INFORMATION (to be filled in block letters) </th>
            </tr> 
            <tr style="font-size:14px; color:#4682B4; font-weight:bold">
                <td colspan = "4" height = "25"> Applicants Details </td> 
            </tr> <br/>
            <tr style="font-size:12px; color:#4682B4">
                <td height = "25" width = "20%">
                    <b> a) Mr./Ms. : </b>
                </td>
                <td colspan = "3" height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Name}"/>
                </td>               
            </tr>
            
            <tr style="font-size:12px; color:#4682B4">
                <td height = "25" width = "20%">
                   <b> S/o D/o W/o : </b>
                </td>
                <td colspan = "3" height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Salutation__c}"/>
                </td>
            </tr> 
            
            <tr style="font-size:12px; color:#4682B4"> 
                <td height = "25" width = "20%">   
                   <b> Date Of Birth : </b>
                </td>
                <td height = "25" width = "30%">
                    <apex:outputField value="{!Opportunity.Contact__r.Birthdate}"/>
                </td>
                <td height = "25" width = "30%">
                   <b> Anniversary Date : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Anniversary_Date__c}"/>
                </td>                
            </tr>
            
            <tr style="font-size:12px; color:#4682B4"> 
                <td height = "25" width = "20%">   
                   <b> Email Id : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Email}"/>
                </td>
                <td height = "25" width = "25%">
                   <b> Mobile No : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.MobilePhone}"/>
                </td>                
            </tr>
            
            <tr style="font-size:12px; color:#4682B4"> 
                <td height = "25" width = "20%">   
                   <b> PAN No : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.PAN_Card__c}"/>
                </td>
                <td height = "25" width = "25%">
                   <b> Passport No : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Passport_No__c}"/>
                </td>                
            </tr>
            
            <tr style="font-size:12px; color:#4682B4"> 
                <td height = "25" width = "20%">   
                   <b> Nationality : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Nationality__c}"/>
                </td>
                <td height = "25" width = "25%">
                   <b> Res.Status: Resident/Non-Resident : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Resident_Status__c}"/>
                </td>                
            </tr>
            
            <tr style="font-size:12px; color:#4682B4"> <td height = "20" colspan ="4"> </td> </tr>
            
            <tr style="font-size:14px; color:#4682B4"> 
                <td height = "25" colspan = "4">   
                   <b> Professional Details : </b>
                </td>                              
            </tr>
            
            <tr style="font-size:12px; color:#4682B4"> 
                <td height = "25" width = "20%">   
                   <b> Profession : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Profession__c}"/>
                </td>
                <td height = "25" width = "25%">
                   <b> Industry : </b>
                </td>            
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Industry__c}"/>
                </td> 
            </tr>
            <tr style="font-size:12px; color:#4682B4">    
                <td height = "25" width = "20%">   
                   <b> Employeed at : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Employed_at__c}"/>
                </td>
                <td height = "25" width = "25%">
                   <b> Designation : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Designation__c}"/>
                </td>                
            </tr>
         </table>
            
            <hr style="border:none; border-top:2px dashed; color:#4682B4"/> 
      
         <table width = "100%">     
            <tr style="font-size:12px; color:#4682B4">
                <td height = "25" width = "20%">
                    <b> b) Mr./Ms. : </b>
                </td>
                <td colspan = "3" height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Co_Applicant_Name__c}"/>
                </td>               
            </tr>
            
            <tr style="font-size:12px; color:#4682B4">
                <td height = "25" width = "20%">
                   <b> S/o D/o W/o : </b>
                </td>
                <td colspan = "3" height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Co_App_rel_salutation__c}"/>
                </td>
            </tr> 
            
            <tr style="font-size:12px; color:#4682B4"> 
                <td height = "25" width = "20%">   
                   <b> Date Of Birth : </b>
                </td>
                <td height = "25" width = "30%">
                    <apex:outputField value="{!Opportunity.Contact__r.date_of_birth__c}"/>
                </td>
                <td height = "25" width = "30%">
                   <b> Anniversary Date : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Co_App_Anniversary_Date__c}"/>
                </td>                
            </tr>
            
            <tr style="font-size:12px; color:#4682B4"> 
                <td height = "25" width = "20%">   
                   <b> Email Id : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Co_App_Email_Id__c}"/>
                </td>
                <td height = "25" width = "25%">
                  <b> Mobile No : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Co_App_Mobile_No__c}"/>
                </td>                
            </tr>
            
            <tr style="font-size:12px; color:#4682B4"> 
                <td height = "25" width = "20%">   
                   <b> PAN No : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Co_App_PAN_No__c}"/>
                </td>
                <td height = "25" width = "25%">
                   <b> Passport No : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Co_App_Passport_No__c}"/>
                </td>                
            </tr>
            
            <tr style="font-size:12px; color:#4682B4"> 
                <td height = "25" width = "20%">   
                   <b> Nationality : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Co_App_Nationality__c}"/>
                </td>
                <td height = "25" width = "25%">
                   <b> Res.Status: Resident/Non-Resident : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Co_App_Residential_Status__c}"/>
                </td>                
            </tr>
            
            <tr style="font-size:12px; color:#4682B4"> <td height = "20" colspan ="4"> </td> </tr>
            
            <tr style="font-size:14px; color:#4682B4"> 
                <td height = "25" colspan = "4">   
                   <b> Professional Details : </b>
                </td>                              
            </tr>
            
            <tr style="font-size:12px; color:#4682B4"> 
                <td height = "25" width = "20%">   
                   <b> Profession : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Profession__c}"/>
                </td>
                <td height = "25" width = "25%">
                   <b> Industry : </b>
                </td>            
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Industry__c}"/>
                </td> 
            </tr>
            <tr style="font-size:12px; color:#4682B4">    
                <td height = "25" width = "20%">   
                   <b> Employeed at : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Employed_at__c}"/>
                </td>
                <td height = "25" width = "25%">
                   <b> Designation : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Designation__c}"/>
                </td>                
            </tr>
         </table>
            <br/>
            <hr style="size:1px; color:#4682B4"/>
         
         <table width = "100%">
            <tr style="font-size:12px; color:#4682B4">
                <td height = "25" width = "50%">
                    <b> Correspondence address : </b>
                </td> 
                <td height = "25" width = "50%">
                    <b> Permanent address : </b>
                </td>
            </tr>
            
            <tr style="font-size:12px; color:#4682B4">
                <td height = "25">
                    <apex:outputText value="{!Opportunity.Contact__r.MailingStreet} <br/> {!Opportunity.Contact__r.MailingCity} <br/> {!Opportunity.Contact__r.MailingState} <br/> {!Opportunity.Contact__r.MailingPostalCode} <br/> {!Opportunity.Contact__r.MailingCountry}" escape = "false"/>
                </td>
                <td height = "25">
                    <apex:outputText value="{!Opportunity.Contact__r.OtherStreet} <br/> {!Opportunity.Contact__r.OtherCity} <br/> {!Opportunity.Contact__r.OtherState} <br/> {!Opportunity.Contact__r.OtherPostalCode} <br/> {!Opportunity.Contact__r.OtherCountry}" escape = "false"/>
                </td>
            </tr>
        </table>
        <table width = "100%">
            <tr style="font-size:12px; color:#4682B4">
                <td height = "25" width = "5%">
                    <b> Pin : </b>
                </td>
                <td height = "25" width = "10%">
                    
                </td>
                <td height = "25" width = "10%">
                    <b> Tel : </b>
                </td>
                <td height = "25" width = "10%">
                    
                </td>
                
                <td height = "25" width = "5%">
                    <b> Pin : </b>
                </td>
                <td height = "25" width = "10%">
                    
                </td>
                <td height = "25" width = "10%">
                    <b> Tel : </b>
                </td>
                <td height = "25" width = "10%">
                    
                </td>
            </tr>
        </table> 
           
           <hr style="size:1px; color:#4682B4"/>
        
        <table width = "100%"> 
            <tr style="font-size:12px; color:#4682B4">
                <td height = "25" colspan = "2">
                   <b> Power of Attorney holder's name (if required) : (a)Mr./Ms. </b>
                </td>
                <td height = "25" colspan = "2">
                    <apex:outputField value="{!Opportunity.Contact__r.Attorney_holder_Name__c}"/>
                </td>
            </tr>
            
            <tr style="font-size:12px; color:#4682B4">
                <td height = "25" width = "25%">
                  <b> Power of Attorney holder's address : </b>
                </td>
                <td height = "25" colspan = "3">
                    <apex:outputField value="{!Opportunity.Contact__r.Attorney_holder_Address__c}"/>
                </td>
            </tr>
            
            <tr style="font-size:12px; color:#4682B4">
                <td height = "25" width = "20%">
                 <b> Email ID : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Attorney_Holder_Email__c}"/>
                </td>
                <td height = "25" width = "20%">
                   <b> Mobile No : </b>
                </td>
                <td height = "25" width = "25%">
                    <apex:outputField value="{!Opportunity.Contact__r.Attorney_Holder_mobile__c}"/>
                </td>

            </tr>
                 
            <tr style="font-size:14px; color:black; font-weight:bold"> 
                <td colspan = "4"> 
                    ______________________________________________&nbsp;Page 1&nbsp;_______________________________________________ 
                </td>
            </tr><br/> 
        </table>
           
                                            <!-- Page 2 -->
                         
        <table  class="table" border="1" width ="100%" cellpadding ="0" cellspacing= "0" bordercolor="SteelBlue">
            <tr width = "100%"> <td style="text-align:center; font-size:16px; background-color:#9E1721; color:White" colspan = "3"> UNIT DETAILS </td> </tr>
            <tr style="font-size:12px; color:#4682B4;"> 
                <td width = "30%"  height = "30"> <b> Bldg. No: </b> &nbsp;&nbsp; <apex:outputField value="{!Opportunity.Block__c}"/> </td>
                <td width = "30%"  height = "30"> <b> Unit No: </b> &nbsp;&nbsp; <apex:outputField value="{!Opportunity.Flat_No__c}"/> </td>
                <td width = "30%"  height = "30"> <b> Floor No: </b> &nbsp;&nbsp; <apex:outputField value="{!Opportunity.Apartment__r.Floor_No__c}"/> </td>           
            </tr>
        </table>
        <table class="table" border="1" width ="100%" cellpadding ="0" cellspacing= "0">
            <tr style="font-size:12px; color:#4682B4;"> 
                <td width = "20%"  height = "30"> <b> SBUA Per sq.ft*: </b> &nbsp;&nbsp; <apex:outputField value="{!Opportunity.Built_Up_Area__c}"/> </td>
                <td width = "25%"  height = "30"> <b> Base Rate Per sq.ft: </b> &nbsp;&nbsp; <apex:outputField value="{!Opportunity.Apartment__r.Apartment_rate__c}"/> </td>
                <td width = "20%"  height = "30"> <b> Floor Rise Charges Per sq.ft: </b> &nbsp;&nbsp; <apex:outputField value="{!Opportunity.Apartment__r.Floor_Rise_Charges_Per_Sqft__c}"/> </td>           
            </tr>
        </table>
        <table class="table" border="1" width ="100%" cellpadding ="0" cellspacing= "0">
            <tr style="font-size:12px; color:#4682B4;"> 
                <td width = "30%"  height = "30"> <b> Preferred Location Charges Per sq.ft: </b> &nbsp;&nbsp; <apex:outputField value="{!Opportunity.Apartment__r.Premium_Charges__c}"/> </td>
                <td width = "20%"  height = "30"> <b> Total Rate Per sq.ft: &nbsp;&nbsp;</b> <apex:outputField value="{!Opportunity.Apartment__r.Apartment_rate__c}"/></td>                          
            </tr>
        </table>
        <table class="table" border="1" width ="100%" cellpadding ="0" cellspacing= "0">
            <tr style="font-size:12px; color:#4682B4;"> 
                <td colspan="5" width = "30%" height = "30"> <b> Basic cost of the apartment: </b> &nbsp;&nbsp; 
                  <apex:outputText value="{0, Number, #,###}">
                    <apex:param value="{!(Opportunity.Apartment__r.Apartment_rate__c * Opportunity.Apartment__r.Built_Up_Area__c)}"/> 
                  </apex:outputText>
                </td>                                          
            </tr>
       
            <tr style="font-size:12px; color:#4682B4;"> 
                <td width = "50%"  height = "30"> <b> No. of car parks: </b> &nbsp;&nbsp; <apex:outputField value="{!Opportunity.Number_of_Carpark__c}"/> </td>
                <td width = "50%"  height = "30"> <b> Car Park Type: </b> &nbsp;&nbsp; <apex:outputField value="{!Opportunity.Apartment__r.Car_Park_Type__c}"/> </td>                
            </tr>
        
            <tr style="font-size:12px; color:#4682B4;"> 
                <td colspan = "2" width = "30%" height = "30"> <b> Total cost of car parks: </b> &nbsp;&nbsp; <apex:outputField value="{!Opportunity.Car_Park_Rate__c}"/> </td>                                          
            </tr>
        </table>
        <table class="table" border="1" width ="100%" cellpadding ="0" cellspacing= "0">
            <apex:repeat value="{!oppdet}"  var="od">
            <tr style="font-size:12px; color:#4682B4;"> 
                <td width = "20%"  height = "30"> <b> Terrace area: </b>  </td>
                <td width = "15%"  height = "30"> <b> Rate per sq.ft: </b> <apex:outputtext value="{!if(contains(OD.Comp1_Name__c,'Terrace'),OD.Comp1_Basic__c,if(contains(OD.Comp2_Name__c,'Terrace'),OD.Comp2_Basic__c,if(contains(OD.Comp3_Name__c,'Terrace'),OD.Comp3_Basic__c,if(contains(OD.Comp4_Name__c,'Terrace'),OD.Comp4_Basic__c,if(contains(OD.Comp5_Name__c,'Terrace'), OD.Comp5_Basic__c, 0)))))}"/> </td>
                <td width = "15%"  height = "30"> <b> Cost: </b> <apex:outputField value="{!Opportunity.Apartment__r.Terrace_Area__c}"/>  </td>                
            </tr>
        
            <tr style="font-size:12px; color:#4682B4;"> 
                <td width = "20%"  height = "30"> <b> Garden area: </b> &nbsp;&nbsp;  </td>
                <td width = "15%"  height = "30"> <b> Rate per sq.ft: </b> <apex:outputtext value="{!if(contains(OD.Comp1_Name__c,'Garden'),OD.Comp1_Basic__c,if(contains(OD.Comp2_Name__c,'Garden'),OD.Comp2_Basic__c,if(contains(OD.Comp3_Name__c,'Garden'),OD.Comp3_Basic__c,if(contains(OD.Comp4_Name__c,'Garden'),OD.Comp4_Basic__c,if(contains(OD.Comp5_Name__c,'Garden'), OD.Comp5_Basic__c, 0)))))}"/> </td>
                <td width = "15%"  height = "30"> <b> Cost: </b> <apex:outputField value="{!Opportunity.Apartment__r.Garden_Area__c}"/> </td>                
            </tr>
          </apex:repeat>
        </table>
        <table class="table" border="1" width ="100%" cellpadding ="0" cellspacing= "0">
            <apex:repeat value="{!oppdet}"  var="od">
            <tr style="font-size:14px; color:#4682B4;"> 
                <td colspan = "3" width = "30%" height = "30"> <b> Agreement Value: </b>  
                 <apex:outputtext value="{!(if(contains(OD.Comp1_Name__c , 'Construction'),OD.Comp1_Basic__c,if(contains(OD.Comp2_Name__c , 'Construction'),OD.Comp2_Basic__c,if(contains(OD.Comp3_Name__c , 'Construction'),OD.Comp3_Basic__c,if(contains(OD.Comp4_Name__c , 'Construction'),OD.Comp4_Basic__c,if(contains(OD.Comp5_Name__c , 'Construction'), OD.Comp5_Basic__c, 0)))))
                                           +
                                            if(contains(OD.Comp1_Name__c , 'Land'),OD.Comp1_Basic__c,if(contains(OD.Comp2_Name__c , 'Land'),OD.Comp2_Basic__c,if(contains(OD.Comp3_Name__c , 'Land'),OD.Comp3_Basic__c,if(contains(OD.Comp4_Name__c , 'Land'),OD.Comp4_Basic__c,if(contains(OD.Comp5_Name__c , 'Land'), OD.Comp5_Basic__c, 0)))))
                                           +
                                            if(contains(OD.Comp1_Name__c , 'Floor'),OD.Comp1_Basic__c,if(contains(OD.Comp2_Name__c , 'Floor'),OD.Comp2_Basic__c,if(contains(OD.Comp3_Name__c , 'Floor'),OD.Comp3_Basic__c,if(contains(OD.Comp4_Name__c , 'Floor'),OD.Comp4_Basic__c,if(contains(OD.Comp5_Name__c , 'Floor'), OD.Comp5_Basic__c, 0)))))
                                           +
                                           if(contains(OD.Comp1_Name__c , 'Car park'),OD.Comp1_Basic__c,if(contains(OD.Comp2_Name__c , 'Car park'),OD.Comp2_Basic__c,if(contains(OD.Comp3_Name__c , 'Car park'),OD.Comp3_Basic__c,if(contains(OD.Comp4_Name__c , 'Car park'),OD.Comp4_Basic__c,if(contains(OD.Comp5_Name__c , 'Car park'), OD.Comp5_Basic__c, 0)))))
                                          )}"/> </td>                                        
            </tr>
            <tr style="font-size:14px; color:#4682B4;"> 
                <td colspan = "3" width = "30%"  height = "30"> <b> One Time Charge: </b></td>                                          
            </tr>
          </apex:repeat>
        </table>
        <table class="table" border="1" width ="100%" cellpadding ="0" cellspacing= "0">
          <apex:repeat value="{!oppdet}"  var="od">
