                                                    </div>
                                                </div>
                                            </div>
                                            <div class="slds-size_1-of-2 slds-max-small-size_1-of-1">
                                                <!--<div class="slds-form-element slds-form-element_horizontal slds-is-editing">
                                                    <label class="slds-form-element__label">
                                                        Address</label>
                                                    <div class="slds-form-element__control">
                                                        <lightning:input type="text" name="input3"  value="{!v.opp.Address3__c}"/>
                                                        
                                                    </div>
                                                </div>-->
                                                <div class="slds-form-element slds-is-editing">
                                                    
                                                    <div class="slds-form-element__control">
                                                        <lightning:input label="Address" type="text" name="input3"  value="{!v.opp.Address3__c}" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="slds-scope">
                                        <div class="slds-grid slds-wrap slds-text-align_left">
                                            <div class="slds-size_1-of-2 slds-max-small-size_1-of-1">
                                                <!--<div class="slds-form-element slds-form-element_horizontal slds-is-editing">
                                                    <label class="slds-form-element__label">
                                                        Adhaar Number</label>
                                                    <div class="slds-form-element__control">
                                                        <lightning:input type="text" maxlength="14" name="adhaarno3"  value="{!v.opp.Aadhar_Number3__c}"/>
                                                        
                                                    </div>
                                                </div>-->
                                                <div class="slds-form-element slds-is-editing">
                                                    
                                                    <div class="slds-form-element__control">
                                                        <lightning:input label="Adhaar Number" type="text" maxlength="14" name="adhaarno3"  value="{!v.opp.Aadhar_Number3__c}" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="slds-size_1-of-2 slds-max-small-size_1-of-1">
                                                <!--<div class="slds-form-element slds-form-element_horizontal slds-is-editing">
                                                    <label class="slds-form-element__label">
                                                        PAN Number</label>
                                                    <div class="slds-form-element__control">
                                                        <lightning:input type="text" maxlength="10" name="panno3" value="{!v.opp.PAN_Number3__c}" />
                                                        
                                                    </div>
                                                </div>-->
                                                <div class="slds-form-element slds-is-editing">
                                                    
                                                    <div class="slds-form-element__control">
                                                        <lightning:input label="PAN Number" type="text" maxlength="10" name="panno3" value="{!v.opp.PAN_Number3__c}"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                </aura:set>
                            </lightning:accordionSection>
                            
                            <!-- BOOKING SECTION -->
                            <lightning:accordionSection name="D" label="Booking Details">
                                
                                <aura:set attribute="body">
                                    <div class="slds-scope">
                                        <div class="slds-grid slds-wrap slds-text-align_left">
                                            <div class="slds-size_1-of-2 slds-max-small-size_1-of-1">
                                                <!-- <div class="slds-form-element slds-form-element_horizontal slds-is-editing">
                                                    <label class="slds-form-element__label" >
                                                        Lead Source</label>
                                                    <div class="slds-form-element__control">
                                                        <lightning:select name="select" value="{!v.opp.Source__c}">
                                                            <option value="">None</option>
                                                            <option value="{!v.LeadSource}">{!v.LeadSource}</option>
                                                            <aura:iteration items="{!v.sources}" var="s">
                                                                <option value="{!s}" text="{!s}"></option>
                                                            </aura:iteration>
                                                        </lightning:select>
                                                        
                                                    </div>
                                                </div>-->
                                                <div class="slds-form-element__control">
                                                    <lightning:select label="Lead Source" name="select" value="{!v.opp.Source__c}">
                                                        <option value="">--None--</option>
                                                        <aura:iteration items="{!v.sources}" var="s">
                                                            <option value="{!s}" text="{!s}" selected="{!v.opp.Source__c}"></option>
                                                        </aura:iteration>
                                                    </lightning:select>
                                                </div>
                                            </div>
                                            <div class="slds-size_1-of-2 slds-max-small-size_1-of-1">
                                                <!--<div class="slds-form-element slds-form-element_horizontal slds-is-editing">
                                                    <label class="slds-form-element__label" >
                                                        Date of Booking</label>
                                                    <div class="slds-form-element__control">
                                                        <lightning:input type="date" name="input3"  value="{!v.opp.Date_of_Booking__c}"/>
                                                        
                                                    </div>
                                                </div>-->
                                                <div class="slds-form-element slds-is-editing">
                                                    
                                                    <div class="slds-form-element__control">
                                                        <lightning:input label="Date of Booking" type="date" name="input3" value="{!v.opp.Date_of_Booking__c}"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="slds-scope">
                                        <div class="slds-grid slds-wrap slds-text-align_left">
                                            <div class="slds-size_1-of-2 slds-max-small-size_1-of-1">
                                                <!--<div class="slds-form-element slds-form-element_horizontal slds-is-editing">
                                                    <label class="slds-form-element__label">
                                                       Booking Source</label>
                                                    <div class="slds-form-element__control">
                                                        <lightning:select name="select" value="{!v.opp.Booking_Source__c}">
                                                            <option value="">None</option>
                                                            <aura:iteration items="{!v.sources}" var="s">
                                                                <option value="{!s}" text="{!s}"></option>
                                                            </aura:iteration>
                                                        </lightning:select>
                                                        
                                                    </div>
                                                    
                                                </div>-->
                                                <div class="slds-form-element__control">
                                                    <lightning:select label="Booking Source" name="select" value="{!v.opp.Booking_Source__c}">
                                                        <option value="">--None--</option>
                                                        <aura:iteration items="{!v.sources}" var="s">
                                                            <option value="{!s}" text="{!s}"></option>
                                                        </aura:iteration>
                                                    </lightning:select>
                                                </div>
                                            </div>   
                                            <div class="slds-size_1-of-2 slds-max-small-size_1-of-1">
                                                <!--<div class="slds-form-element slds-form-element_horizontal slds-is-editing">
                                                    <label class="slds-form-element__label">
                                                          FLS Name</label>
                                                    <div class="slds-form-element__control">
                                                        <lightning:input type="text" name="input3"  value="{!v.opp.FLS_Name__c}"/>
                                                        
                                                    </div>
                                                </div>-->
                                                <div class="slds-form-element slds-is-editing">
                                                    
                                                    <div class="slds-form-element__control">
                                                        <lightning:input label="FLS Name" type="text" name="input3"  value="{!v.opp.FLS_Name__c}"/>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                        </div>
                                    </div>
                                    
                                    
                                    
                                    <div class="slds-scope">
                                        <div class="slds-grid slds-wrap slds-text-align_left">
                                            <div class="slds-size_1-of-2 slds-max-small-size_1-of-1">
                                                <!--<div class="slds-form-element slds-form-element_horizontal slds-is-editing">
                                                    <label class="slds-form-element__label">
                                                         Team Lead</label>
                                                    <div class="slds-form-element__control">
                                                        <lightning:input type="text" name="input3" value="{!v.opp.Team_Lead__c}" />
                                                        
                                                    </div>
                                                </div>-->
                                                <div class="slds-form-element slds-is-editing">
                                                    
                                                    <div class="slds-form-element__control">
                                                        <lightning:input label="Team Lead" type="text" name="input3" value="{!v.opp.Team_Lead__c}"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                </aura:set>
                            </lightning:accordionSection>
                            
                        </lightning:accordion>
                        
                        
                        
                        </div>
                    </p>
                    
                </div>
                
            </aura:if>
            <aura:if isTrue="{!v.showPlotPopup}">
                
                <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                    <p><div class="slds-form">
                        <div class="slds-grid">
                            <div class="slds-col slds-size_1-of-2">
                                <div class="slds-form-element slds-form-element_horizontal slds-is-editing">
                                    <label class="slds-form-element__label">
                                        <abbr class="slds-required" title="required">* </abbr>Opportunity</label>
                                    <div class="slds-form-element__control">
                                        <lightning:input type="text" value="{!v.opp.Name}" readonly="true"/>
                                    </div>
                                </div>
                            </div>
                            <lightning:buttonIcon iconName="utility:add"  size="large" variant="bare" alternativeText="Add" onclick="{!c.addRow}"/>
                        </div>
                        
                        <div class="slds-scrollable">
                            <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-table_col-bordered"> 
                                <thead>
                                    <tr class="slds-text-title_caps">
                                        <th scope="col">
                                            <div style="width: 20px" class="slds-truncate">Sl. No.</div>
                                        </th>
                                        <th scope="col">
                                            <div class="slds-truncate" title="Plot">Plot</div>
                                        </th>
                                        <th scope="col">
                                            <div class="slds-truncate" title="Size">Size</div>
                                        </th>
                                        <!-- <th scope="col">
                                            <div class="slds-truncate" title="Min. Price">Min. Price</div>
                                        </th>
                                         <th scope="col">
                                            <div class="slds-truncate" title="Max. Price">Max. Price</div>
                                        </th>-->
                                        <th scope="col">
                                            <div class="cont" title="Rate Per Sq.Ft.">Rate Per Sq.Ft.</div>
                                        </th>
                                        <th scope="col">
                                            <div class="slds-truncate" title="Total">Total</div>
                                        </th>
                                        <th scope="col">
                                            <div class="slds-truncate" title="Actions">Actions</div>
                                        </th>
                                    </tr>
                                </thead>   
                                <tbody>     
                                    <aura:iteration items="{!v.oppplot}" var="plot" indexVar="index">
                                        <!--  <c:DynamicRowItem  plots="{!v.plots}" selPlot="{!plot}"  rowIndex="{!index}" /> -->
                                        <tr class="slds-hint-parent">
                                            <td> 
                                                {!index + 1}
                                            </td>
                                            
                                            
                                            <td>
                                                <div style="width: 150px"  class="slds-truncate" data-record="{!index}"  >
                                                    <c:plotLookup  plots="{!v.plots}" value="{!plot.Plot__c}" size="{!plot.Plot_size__c}" rate="{!plot.Rate_per_sqft_Sales__c }" minprice="{!plot.Minimum_Price__c}" maxprice="{!plot.Maximum_Price__c}" total="{!plot.All_inclusive_price__c}"></c:plotLookup> 
                                                </div>
                                            </td>
                                            <td>
                                                <div style="width: 100px"  class="slds-truncate"  data-record="{!index}" onchange="{!c.calculateTotal}" >
                                                    <lightning:input name="plotsize" type="number" required="true" maxlength="50" label="Size" messageWhenValueMissing="Enter Size"  value="{!plot.Plot_size__c}" />
                                                </div>
                                            </td>
                                            <!-- <td>
                                                <div style="width: 100px" class="slds-truncate"  data-record="{!index}">
                                                    <lightning:input name="min" type="number" formatter="currency" step="0.01" maxlength="50" label="Min. Price" value="{!plot.Minimum_Price__c}" readonly="true" />
                                                </div>
                                            </td>
                                            <td>
                                                <div style="width: 100px" class="slds-truncate"  data-record="{!index}">
                                                    <lightning:input name="max" type="number" formatter="currency" step="0.01" maxlength="50" label="Max. Price" value="{!plot.Maximum_Price__c}" readonly="true" />
                                                </div>
                                            </td>-->
                                            <td>
                                                <div  style="width: 120px" class="slds-truncate"  data-record="{!index}"  onchange="{!c.calculateTotal}" >
                                                    <lightning:input name="rate" type="number" formatter="currency" step="0.01" required="true" maxlength="50" label="Rate Per Sqft." messageWhenValueMissing="Enter Rate" messageWhenRangeOverflow="Value is above range." max="{!plot.Maximum_Price__c}" messageWhenRangeUnderflow="Value is below range" min="{!plot.Minimum_Price__c}" value="{!plot.Rate_per_sqft_Sales__c }"/>
                                                </div>
                                            </td>
                                            <td>
                                                <div style="width: 120px" class="slds-truncate"  data-record="{!index}">
                                                    <lightning:input name="total" type="number" formatter="currency" step="0.01" maxlength="50" label="Total" value="{!plot.All_inclusive_price__c}" readonly="true" />
                                                </div>
                                            </td>
                                            <td>
                                                <aura:if isTrue="{!index != 0}">
                                                    <a onclick="{!c.removeRow}" data-record="{!index}">
                                                        <lightning:icon iconName="utility:delete" size="small" alternativeText="Delete"/>
                                                        <span class="slds-assistive-text">Delete</span>
                                                    </a>
                                                </aura:if>
                                            </td> 
                                        </tr>
                                        
                                    </aura:iteration>
                                </tbody>
                            </table>
                        </div>
                        
                        
                        </div>
                    </p>
                </div>
                
            </aura:if>   
            
            <footer class="slds-modal__footer">
                <lightning:button label="Cancel" title="Cancel" onclick="{! c.cancel }" />
                
                <aura:if isTrue="{!v.showPlotPopup == false}">
                    <lightning:button variant="brand" label="Save" title="Save" onclick="{! c.save2 }" />
                    <!--<lightning:button variant="brand" label="Next" title="Next" onclick="{! c.next }" />-->
                </aura:if>
                
                <aura:if isTrue="{!v.showPlotPopup}">
                    <lightning:button variant="brand" label="Previous" title="Previous" onclick="{! c.previous }" />
                    <lightning:button variant="brand" label="Save" title="Save" onclick="{! c.save }" />
                </aura:if>
                
            </footer>
            
            
        </div>
    </div>
    
</aura:component>