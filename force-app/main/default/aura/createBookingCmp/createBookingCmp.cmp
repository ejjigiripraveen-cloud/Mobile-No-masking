                                                        <option value="">None</option>
                                                        <aura:iteration items="{!v.projects}" var="p">
                                                            <option value="{!p.Id}" selected="{!p.Name==v.opp.Project_Name__c}" text="{!p.Name}"></option>
                                                        </aura:iteration>
                                                    </lightning:select>-->
                                                    <div class="slds-combobox_container">
