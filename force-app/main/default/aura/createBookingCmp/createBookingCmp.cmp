                                                <div class="slds-form-element__control">
                                                    <lightning:input label="Customer DOB" type="date" name="input3"  value="{!v.opp.Customer_DOB__c}" required="true"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="slds-size_1-of-2 slds-max-small-size_1-of-1">
                                            <!--<div class="slds-form-element slds-form-element_horizontal slds-is-editing">
                                                <label class="slds-form-element__label">
                                                    Email</label>
                                                <div class="slds-form-element__control">
                                                    <lightning:input type="email" name="email1" value="{!v.opp.Email_ID__c}" />
                                                    
