                                                <label class="slds-form-element__label">
                                                    Adhaar Number</label>
                                                <div class="slds-form-element__control">
                                                    <lightning:input type="text" maxlength="14" name="adhaarno1"  value="{!v.opp.Aadhar_Number__c}"/>
                                                    
