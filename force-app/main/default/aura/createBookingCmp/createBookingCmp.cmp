                                                <div class="slds-form-element slds-is-editing">
                                                    
                                                    <div class="slds-form-element__control">
                                                        <lightning:input label="Contact number" type="tel" value="{!v.opp.Contact_Number3__c}"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="slds-scope">
                                        <div class="slds-grid slds-wrap slds-text-align_left">
                                            <div class="slds-size_1-of-2 slds-max-small-size_1-of-1">
                                                <!--<div class="slds-form-element slds-form-element_horizontal slds-is-editing">
                                                    <label class="slds-form-element__label">
                                                        Email</label>
                                                    <div class="slds-form-element__control">
                                                        <lightning:input type="email" name="email2" value="{!v.opp.Email_Id3__c}" />
                                                        
